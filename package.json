{
  "name": "pipeline-github-vercel",
  "version": "1.0.0",
  "private": true,
  "description": "Pipeline CI/CD com GitHub Actions e Vercel",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:perf": "node tests/perf/load.js",
    "build": "node scripts/build.js",
    "dev": "node --watch api/server.js",
    "audit:prod": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autocannon": "^8.0.0",
    "eslint": "^10.13.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
